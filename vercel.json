{
  "rewrites": [
    {
      "source": "/tin-tuc/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Viber|Twitterbot|Googlebot|LinkedInBot|bot|spider|crawl).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}